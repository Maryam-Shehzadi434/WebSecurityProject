<!DOCTYPE html>
<html><head><title>Profile</title><link rel="stylesheet" href="/style.css"></head>
<body>
<div class="topbar">Education Portal
  <span style="float:right"><a href="/dashboard">Dashboard</a><a href="/logout">Logout</a></span>
</div>
<div class="wrap">
  <div class="card">
    <h1>My Profile</h1>
    <p>Username: <b><%= user.username %></b></p>
    <p>Current email: <b><%= user.email %></b></p>
    <h2>Change email</h2>
    <%# VULNERABLE: this form has NO csrf token, so an outside page can forge it %>
    <form method="POST" action="/update-email">
      <label>New email</label>
      <input type="email" name="email" value="<%= user.email %>">
      <button type="submit">Update email</button>
    </form>
    <% if (typeof msg !== 'undefined' && msg) { %><p class="ok"><%= msg %></p><% } %>
  </div>
</div>
</body></html>
